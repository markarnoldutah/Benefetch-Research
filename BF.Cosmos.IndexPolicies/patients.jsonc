{
  "indexingMode": "consistent",
  "automatic": false,
  "includedPaths": [
    { "path": "/patientId/?" },
    { "path": "/tenantId/?" },
    { "path": "/practiceId/?" },
    { "path": "/type/?" },

    { "path": "/firstName/?" },
    { "path": "/lastName/?" },
    { "path": "/dateOfBirth/?" },

    { "path": "/coverageEnrollments/[]/coverageEnrollmentId/?" },
    { "path": "/coverageEnrollments/[]/payerId/?" },
    { "path": "/coverageEnrollments/[]/planType/?" },
    { "path": "/coverageEnrollments/[]/isActive/?" },

    { "path": "/createdAtUtc/?" },
    { "path": "/updatedAtUtc/?" }
  ],
  "excludedPaths": [{ "path": "/*" }]
}

