{
  "info": {
    "name": "EC API \u2013 Manual UX Test Plan",
    "_postman_id": "ec-api-ux-test-plan-autogen",
    "description": "End-to-end user-journey oriented tests for the EC (Eligibility Checker) API.\n\nEnvironments expected:\n- baseUrl (e.g. https://localhost:5001)\n- accessToken (JWT for a test tenant)\n\nScenarios:\n1) Admin setup\n2) New patient with single coverage\n3) Dual coverage + COB decision\n4) Medical visit using medical plan\n5) Error & edge-case behavior\n6) Direct controller smoke tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 \u2013 Admin Setup",
      "description": "Tenant-level configuration and practice/payer setup.",
      "item": [
