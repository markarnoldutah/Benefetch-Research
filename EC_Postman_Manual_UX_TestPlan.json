                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Encounter \u2013 COB Scenario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encounters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encounters"
              ]
            },
            "description": "Create an encounter where both vision and medical coverage are present.\nSave cobEncounterId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"visitTypeCode\": \"ROUTINE_EYE\",\n  \"visitDate\": \"2025-10-02T15:00:00Z\",\n  \"locationId\": \"loc-main\",\n  \"providerId\": \"doc-1\",\n  \"primaryCoverageEnrollmentId\": \"{{coverageEnrollmentId}}\",\n  \"secondaryCoverageEnrollmentId\": \"{{medicalCoverageEnrollmentId}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Determine COB for Encounter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/encounters/{{cobEncounterId}}/cob",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "encounters",
                "{{cobEncounterId}}",
                "cob"
              ]
            },
            "description": "Call the COB/coverage-selection endpoint for the encounter.\nVerify primary/secondary decision matches the rules in config.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
