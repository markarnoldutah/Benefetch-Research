    {
      "name": "03 \u2013 Dual Coverage & COB",
      "description": "Patient with both vision and medical coverage; COB decision and multiple eligibility checks.",
      "item": [
        {
          "name": "Add Medical Coverage Enrollment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/{{patientId}}/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "{{patientId}}",
                "coverage"
              ]
            },
            "description": "Assign a secondary medical coverage to the same patient.\nSave medicalCoverageEnrollmentId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{medicalPayerId}}\",\n  \"memberId\": \"M987654321\",\n  \"groupNumber\": \"GRP-MED-001\",\n  \"coverageType\": \"medical\",\n  \"effectiveFrom\": \"2025-01-01T00:00:00Z\",\n  \"effectiveTo\": \"2025-12-31T00:00:00Z\",\n  \"cobOrder\": 2\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 2xx', function () {",
