    { "path": "/availityPayerCode/?" },
    { "path": "/x12PayerId/?" },

    { "path": "/isMedicare/?" },
    { "path": "/isMedicaid/?" }
  ],
  "excludedPaths": [{ "path": "/*" }]
}

